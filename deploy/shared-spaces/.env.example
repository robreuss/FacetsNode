# Facets Shared Spaces Server
FACETS_SHARED_SPACES_POSTGRES_PASSWORD=replace-with-a-long-random-password
FACETS_SHARED_SPACES_OPERATOR_TOKEN=replace-with-a-separate-32-byte-unpadded-base64url-token
# Generate the operator token, managed-key encryption key, and compute signing
# seed independently with:
# openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n'
FACETS_SHARED_SPACES_MANAGED_KEY_ENCRYPTION_KEY=replace-with-a-32-byte-unpadded-base64url-key
# Generate this independently from the managed-key encryption key.
FACETS_SHARED_SPACES_COMPUTE_CAPABILITY_SIGNING_SEED=replace-with-a-different-32-byte-unpadded-base64url-seed
# Public HTTPS origin embedded in signed compute capabilities.
FACETS_SHARED_SPACES_PUBLIC_URL=https://shared-spaces.example.com
# Optional stable host directory containing server.crt and server.key. This
# lets release directories remain immutable on a persistent deployment host.
# FACETS_SHARED_SPACES_TLS_DIRECTORY=/srv/facets-box/tls/shared-spaces
# Required only by the onion-only override. Generate independently from every
# Facets bearer, authority key, and Tor identity:
# FACETS_SHARED_SPACES_ONION_INGRESS_TOKEN=<32-byte-unpadded-base64url>

# Optional host ports and service tuning.
# FACETS_SHARED_SPACES_MANAGEMENT_PORT=8081
# FACETS_SHARED_SPACES_HTTPS_PORT=9443
# FACETS_SHARED_SPACES_HTTP_TRANSFER_PERIOD=10m
# FACETS_SHARED_SPACES_BLOB_UPLOAD_TTL=168h
# FACETS_SHARED_SPACES_BLOB_ORPHAN_GRACE=24h
# FACETS_SHARED_SPACES_CHECKPOINT_FENCE_TTL=2h
# FACETS_SHARED_SPACES_TRAFFIC_RELAY_MESSAGE_RATE_PER_MINUTE=3000
