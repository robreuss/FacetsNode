# Facets Device Sync Server
FACETS_DEVICE_SYNC_POSTGRES_PASSWORD=replace-with-a-long-random-password
FACETS_DEVICE_SYNC_OPERATOR_TOKEN=replace-with-a-separate-32-byte-unpadded-base64url-token
FACETS_DEVICE_SYNC_PUBLIC_URL=https://your-facets-device-sync.example:8443
# Optional stable host directory containing server.crt and server.key. This
# lets release directories remain immutable on a persistent deployment host.
# FACETS_DEVICE_SYNC_TLS_DIRECTORY=/srv/facets-box/tls/device-sync
# Required only by the onion-only override. Generate independently from every
# Facets bearer, authority key, and Tor identity:
# FACETS_DEVICE_SYNC_ONION_INGRESS_TOKEN=<32-byte-unpadded-base64url>

# Optional host ports and service tuning.
# FACETS_DEVICE_SYNC_MANAGEMENT_PORT=8080
# FACETS_DEVICE_SYNC_HTTPS_PORT=8443
# FACETS_DEVICE_SYNC_HTTP_TRANSFER_PERIOD=10m
# FACETS_DEVICE_SYNC_BLOB_UPLOAD_TTL=168h
# FACETS_DEVICE_SYNC_BLOB_ORPHAN_GRACE=24h
# FACETS_DEVICE_SYNC_CHECKPOINT_FENCE_TTL=2h
# FACETS_DEVICE_SYNC_TRAFFIC_RELAY_MESSAGE_RATE_PER_MINUTE=3000
