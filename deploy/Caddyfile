:8443 {
	tls /etc/facets-server/tls/server.crt /etc/facets-server/tls/server.key

	# Public ingress is deliberately limited to application protocol families.
	# Operator provisioning and operations endpoints remain available only on
	# the server's loopback-bound management ingress.
	route {
		# The single Box URL owns the control plane. Device Sync remains a
		# separate least-privilege process behind its registered subpath.
		handle_path /facetsbox/device-sync/* {
			reverse_proxy server:8080
		}
		handle /facetsbox {
			redir /facetsbox/ 308
		}
		handle_path /facetsbox/* {
			reverse_proxy controller:8081
		}
		@sharedSpaceOperatorProvisioning path /v1/shared-spaces/provisioning-admissions
		respond @sharedSpaceOperatorProvisioning 404
		@application path /.well-known/facets-box /v1/service-deployment/proof /v1/service-deployment/bootstrap-proof /v1/pairing/* /v1/relay/tenants/* /v1/device-sync/account-admissions/* /v1/device-sync/join-requests /v1/device-sync/join-requests/* /v1/device-sync/principals/* /v1/shared-spaces/*
		reverse_proxy @application server:8080
		respond 404
	}
}
