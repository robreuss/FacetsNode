# One Storage Capacity Authority is configured for each retained physical pool.
FACETS_STORAGE_CAPACITY_POSTGRES_PASSWORD=replace-with-a-long-random-password
FACETS_STORAGE_CAPACITY_POOL_ID=replace-with-a-nonzero-uuid

# The capacity-pool child is a content-free sentinel directory on the same
# physical filesystem as service data and the container runtime data root.
FACETS_BOX_DATA_ROOT=/srv/facets-box-data

# Contains the immutable peers.json registry for authorized service
# deployments. The directory and file are readable by container UID 65532.
FACETS_STORAGE_CAPACITY_AUTHORITY_CONFIG_DIRECTORY=/srv/facets-box-data/storage-capacity-authority

# Contains server.crt and server.key. The certificate must be valid for the
# Compose DNS name `storage-capacity`; clients mount only server.crt.
FACETS_STORAGE_CAPACITY_TLS_DIRECTORY=/srv/facets-box-data/tls/storage-capacity

# FACETS_STORAGE_CAPACITY_READINESS_PERIOD=30s
