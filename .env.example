# Generate a unique URL-safe value, for example with: openssl rand -hex 32
FACETS_NODE_POSTGRES_PASSWORD=replace-with-a-unique-64-character-hex-value

# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# This authorizes private tenant provisioning. It is not a database, tenant,
# domain-administration, or member credential.
FACETS_NODE_OPERATOR_TOKEN=replace-with-a-43-character-unpadded-base64url-value

# Optional upper bound for a complete HTTP request or response (maximum 1h).
# FACETS_NODE_HTTP_TRANSFER_PERIOD=10m

# Optional resumable-upload inactivity TTL and authority-loss deletion grace.
# FACETS_NODE_BLOB_UPLOAD_TTL=168h
# FACETS_NODE_BLOB_ORPHAN_GRACE=24h

# Server-owned checkpoint write-fence lifetime (5m minimum, 24h maximum).
# FACETS_NODE_CHECKPOINT_FENCE_TTL=2h

# Optional per-process traffic controls. Each surface supports identity rate,
# connection-address aggregate rate, and concurrency overrides. See README.md
# for every variable and default.
# FACETS_NODE_TRAFFIC_RENDEZVOUS_RATE_PER_MINUTE=300
# FACETS_NODE_TRAFFIC_RENDEZVOUS_BURST=100
# FACETS_NODE_TRAFFIC_RENDEZVOUS_CONNECTION_RATE_PER_MINUTE=2400
# FACETS_NODE_TRAFFIC_RENDEZVOUS_CONNECTION_BURST=400
# FACETS_NODE_TRAFFIC_RENDEZVOUS_CONCURRENCY=32

# Optional private management host port. It remains loopback-only. Restore
# drills use a different port so the recovered stack can run beside the source.
# FACETS_NODE_PUBLISHED_PORT=8080

# Direct HTTPS application port. Caddy forwards only pairing and tenant-scoped
# relay routes; the Node's management/application listener remains loopback-only.
# FACETS_NODE_HTTPS_PORT=8443
