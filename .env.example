# Generate a unique URL-safe value, for example with: openssl rand -hex 32
FACETS_NODE_POSTGRES_PASSWORD=replace-with-a-unique-64-character-hex-value

# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# This authorizes domain provisioning. It is not a database or member credential.
FACETS_NODE_OPERATOR_TOKEN=replace-with-a-43-character-unpadded-base64url-value

# Optional upper bound for a complete HTTP request or response (maximum 1h).
# FACETS_NODE_HTTP_TRANSFER_PERIOD=10m

# Optional loopback host port. Restore drills use a different port so the
# recovered stack can run beside the source without exposing either publicly.
# FACETS_NODE_PUBLISHED_PORT=8080
