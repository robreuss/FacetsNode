# Facets Job Custody and shared physical Storage Capacity Authority
FACETS_JOB_CUSTODY_POSTGRES_PASSWORD=replace-with-a-long-random-password

# The Box Controller publishes this URL. It must also be an allowed control
# endpoint in the Job Custody deployment route policy.
FACETS_JOB_CUSTODY_PUBLIC_URL=https://box.example/facetsbox/job-custody
FACETS_JOB_CUSTODY_DEPLOYMENT_ID=replace-with-a-nonzero-uuid
FACETS_STORAGE_CAPACITY_POOL_ID=replace-with-a-different-nonzero-uuid

# Job Custody content is bind-mounted beneath this retained physical pool.
# The container runtime data root that holds PostgreSQL must be on the same
# filesystem so the shared authority observes all durable service growth.
FACETS_BOX_DATA_ROOT=/srv/facets-box-data

# Contains deployment-signing-key (0600, container UID 65532).
FACETS_JOB_CUSTODY_AUTHORITY_KEY_DIRECTORY=/srv/facets-box-data/job-custody/service-authority/keys
# Contains deployment-routes.json (0600, container UID 65532).
FACETS_JOB_CUSTODY_AUTHORITY_POLICY_DIRECTORY=/srv/facets-box-data/job-custody/service-authority/policy
# Contains bindings.json and is writable only by container UID 65532.
FACETS_JOB_CUSTODY_AUTHORITY_STATE_DIRECTORY=/srv/facets-box-data/job-custody/service-authority/state
# Contains admission-keys.json and admission-authorities.json (0600).
FACETS_JOB_CUSTODY_ADMISSION_DIRECTORY=/srv/facets-box-data/job-custody/admission
# Contains the public server.crt of the separately installed physical Storage
# Capacity Authority. The certificate must be valid for `storage-capacity`.
FACETS_STORAGE_CAPACITY_TLS_DIRECTORY=/srv/facets-box-data/tls/storage-capacity

# Optional bounds and maintenance periods.
# FACETS_JOB_CUSTODY_MAXIMUM_ADMISSIONS=100000
# FACETS_JOB_CUSTODY_MAXIMUM_STAGING_BYTES=2199023255552
# FACETS_JOB_CUSTODY_MAXIMUM_CUSTODY_BYTES=21990232555520
# FACETS_JOB_CUSTODY_STORAGE_CAPACITY_RESERVATION_TTL=5m
# FACETS_JOB_CUSTODY_CLEANUP_PERIOD=1m
# FACETS_JOB_CUSTODY_HTTP_TRANSFER_PERIOD=10m
